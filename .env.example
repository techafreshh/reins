# Custom health check message
PING_MESSAGE=pong

# Skip login/signup (local dev / preview only)
# Auth is enabled when AUTH_DISABLED is unset. Standalone production deploys
# need a stable BETTER_AUTH_SECRET; BETTER_AUTH_URL is inferred automatically.
# BETTER_AUTH_SECRET=
# AUTH_DISABLED=true

# Local database default (PGlite file store used when DATABASE_URL is unset)
# DATABASE_URL=pglite:./data/pglite

# Production deploy (docker compose + VPS)
# ANTHROPIC_API_KEY funds the VPS agent turns behind the per-hour turn cap.
# ANTHROPIC_API_KEY=
# PORT is the port the app serves on (compose publishes 3000).
# PORT=3000
